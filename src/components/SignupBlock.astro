---
import { getEntry } from 'astro:content';
import { inline } from '../lib/markdown';
const SIGNUP = (await getEntry('signup', 'signup'))!.data;
// compact = the smaller About-page version (no body text, no checkbox)
interface Props { compact?: boolean; style?: string; }
const { compact = false, style } = Astro.props;
---
<section class:list={['signup', { 'signup-compact': compact }]} style={style}>
 <div class="wide signup-inner">
  <div class="signup-copy">
    <h2 set:html={inline(SIGNUP.title)} />
    {!compact && <p set:html={inline(SIGNUP.body)} />}
  </div>
  <!-- TODO: connect to an email provider (double opt-in + consent record). -->
  <form data-signup>
    <input class="field" type="email" name="email" inputmode="email" autocomplete="email" placeholder="Email address" aria-label="Email address" required />
    {!compact && (
      <label><input type="checkbox" name="consent" required /><span set:html={inline(SIGNUP.consent)} /></label>
    )}
    <button class="btn btn-block" type="submit">Subscribe</button>
  </form>
 </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-signup]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.outerHTML = '<p class="signup-done">Thanks — you’re on the list.</p>';
    });
  });
</script>

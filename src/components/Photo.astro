---
// One photo, cropped to fill its frame. Photos stored in the repository are resized and converted to a
// fast format when the site is built; web links (https://...) are used as they are.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { focusPosition } from '../lib/photos';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  focus?: string;
  sizes: string; // how wide the frame is on screen, e.g. "100vw"
  widths?: number[];
  eager?: boolean; // load straight away (the main photo at the top of a page)
}
const { src, alt, focus, sizes, widths = [400, 800, 1200, 1600, 2400], eager = false } = Astro.props;
const style = `object-position: ${focusPosition(focus)}`;
const loading = eager ? 'eager' : 'lazy';
const usable = typeof src === 'string' ? [] : widths.filter((w) => w <= src.width);
---
{typeof src === 'string' ? (
  <img class="pic" src={src} alt={alt} style={style} loading={loading} decoding="async" />
) : (
  <Image
    class="pic"
    src={src}
    alt={alt}
    style={style}
    widths={usable.length ? usable : [src.width]}
    sizes={sizes}
    loading={loading}
    fetchpriority={eager ? 'high' : undefined}
  />
)}

<style>
  .pic { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>

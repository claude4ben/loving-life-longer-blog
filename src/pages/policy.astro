---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { inline } from '../lib/markdown';
import { splitSections } from '../lib/sections';

// Text comes from src/content/pages/policy.md
const page = (await getEntry('policy', 'policy'))!;
const d = page.data;
const sections = splitSections(page.body ?? '');
---
<Base title={d.title}>
  <div class="col policy">
    <h1 set:html={inline(d.title)} />
    <p class="intro" set:html={inline(d.intro)} />
    {d.placeholderNote ? <div class="placeholder-note" style="margin-bottom:28px">{d.placeholderNote}</div> : <div style="margin-bottom:28px" />}

    {sections.map((s) => (
      <section id={s.id}>
        <h2>{s.heading}</h2>
        <Fragment set:html={s.html} />
      </section>
    ))}
  </div>
</Base>

<style>
  .policy { padding-top: 40px; padding-bottom: 60px; max-width: 680px; }
  h1 { font-size: 28px; margin: 0 0 10px; }
  .intro { font-size: 16px; color: var(--muted); margin: 0 0 6px; }
  section { margin-bottom: 32px; }
  section:last-child { margin-bottom: 0; }
  h2 { font-size: 20px; margin: 0 0 12px; }
  section :global(p), section :global(li) { font-size: 16px; line-height: 1.65; }
  section :global(p), section :global(ul), section :global(ol) { margin: 0 0 16px; }
  section :global(ul), section :global(ol) { padding-left: 1.4em; }
  section :global(li::marker) { color: var(--accent); }
  section > :global(:last-child) { margin-bottom: 0; }
</style>

---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { inline } from '../lib/markdown';
import { splitSections } from '../lib/sections';

// Text comes from src/content/pages/policy.md
const page = (await getEntry('policy', 'policy'))!;
const d = page.data;
const sections = splitSections(page.body ?? '');
---
<Base title={d.title} description={d.intro}>
  <div class="wide policy">
    <header class="policy-head">
      <h1 set:html={inline(d.title)} />
      <p class="intro" set:html={inline(d.intro)} />
      {d.placeholderNote && <div class="placeholder-note">{d.placeholderNote}</div>}
    </header>

    <div class="policy-body">
      <nav class="on-page" aria-label="On this page">
        <div class="on-page-label">On this page</div>
        {sections.map((s) => <a href={`#${s.id}`}>{s.heading}</a>)}
      </nav>
      <div class="sections">
        {sections.map((s) => (
          <section id={s.id}>
            <h2>{s.heading}</h2>
            <Fragment set:html={s.html} />
          </section>
        ))}
      </div>
    </div>
  </div>
</Base>

<style>
  .policy { padding-top: 40px; padding-bottom: 60px; }
  .policy-head { margin-bottom: 28px; }
  h1 { font-size: 28px; margin: 0 0 10px; }
  .intro { font-size: 16px; color: var(--muted); margin: 0 0 6px; }
  .on-page { display: none; }
  section { margin-bottom: 32px; scroll-margin-top: 100px; }
  section:last-child { margin-bottom: 0; }
  h2 { font-size: 20px; margin: 0 0 12px; }
  section :global(p), section :global(li) { font-size: 16px; line-height: 1.65; }
  section :global(p), section :global(ul), section :global(ol) { margin: 0 0 16px; }
  section :global(ul), section :global(ol) { padding-left: 1.4em; }
  section :global(li::marker) { color: var(--accent); }
  section > :global(:last-child) { margin-bottom: 0; }

  @media (min-width: 960px) {
    .policy { padding-top: 56px; padding-bottom: 80px; }
    .policy-head { margin-bottom: 40px; padding-bottom: 32px; border-bottom: 1px solid var(--subtle); }
    h1 { font-size: 40px; }
    .intro { font-size: 18px; }
    /* "On this page" list on the left (stays in view), policy text on the right. */
    .policy-body { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 56px; align-items: start; }
    .on-page { display: flex; flex-direction: column; position: sticky; top: 100px; border-left: 2px solid var(--subtle); }
    .on-page-label { font-family: var(--font-label); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); padding: 0 0 8px 16px; }
    .on-page a { font-size: 15px; color: var(--ink); padding: 8px 16px; min-height: 40px; }
    .on-page a:hover { color: var(--accent); }
    .sections { max-width: 820px; }
    h2 { font-size: 24px; }
    section :global(p), section :global(li) { font-size: 17px; }
    section { margin-bottom: 40px; }
  }
</style>

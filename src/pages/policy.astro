---
import Base from '../layouts/Base.astro';
---
<Base title="Policies">
  <div class="col policy">
    <h1>Policies</h1>
    <p class="intro">Placeholder intro line — real policy copy pending.</p>
    <div class="placeholder-note" style="margin-bottom:28px">Placeholder copy — real policy content pending.</div>

    <h2 id="comments">Comments policy</h2>
    <p>Placeholder — will cover what kind of comments are welcome and what isn't tolerated.</p>
    <p class="last">Placeholder — will cover moderation and how names/emails are handled.</p>

    <h2 id="privacy">Data &amp; privacy</h2>
    <p>Placeholder — will cover what data is collected (e.g. email signups, comment details), how it's stored, and who it's shared with.</p>
    <p class="last">Placeholder — will cover how to request data deletion.</p>

    <h2 id="cookies">Cookies</h2>
    <p>Placeholder — will cover any analytics or tracking cookies used on the site.</p>
  </div>
</Base>

<style>
  .policy { padding-top: 40px; padding-bottom: 60px; max-width: 680px; }
  h1 { font-size: 28px; margin: 0 0 10px; }
  .intro { font-size: 16px; color: var(--muted); margin: 0 0 6px; }
  h2 { font-size: 20px; margin: 0 0 12px; }
  p { font-size: 16px; line-height: 1.65; margin: 0 0 16px; }
  p.last { margin-bottom: 32px; }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PillarTag from '../components/PillarTag.astro';
import Faq from '../components/Faq.astro';
import SignupBlock from '../components/SignupBlock.astro';
import { HOME_INTRO, PILLAR_COLORS, type Pillar } from '../data/site';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = posts.find((p) => p.data.featured) ?? posts[0];

// Split the headline so {think}, {move} and {live} can be coloured.
const headline = HOME_INTRO.headline.split(/\{(think|move|live)\}/).map((part, i) =>
  i % 2 ? { pillar: (part[0].toUpperCase() + part.slice(1)) as Pillar, text: part } : { text: part },
);
---
<Base>
  <section class="col intro">
    <div class="intro-label">{HOME_INTRO.label}</div>
    <h1>{headline.map((h) => (h.pillar ? <span style={`color:${PILLAR_COLORS[h.pillar]}`}>{h.text}</span> : h.text))}</h1>
    <p>{HOME_INTRO.body}</p>
  </section>

  {featured && (
    <a class="feature" href={`/blog/${featured.id}/`}>
      <div class="feature-label">Latest article</div>
      <div class="feature-img"><img src={featured.data.heroImage} alt={featured.data.heroAlt} /></div>
      <div class="feature-text">
        <PillarTag pillar={featured.data.pillar} />
        <h2>{featured.data.title}</h2>
        <p>{featured.data.standfirst}</p>
        <span class="meta">{featured.data.readTime}</span>
      </div>
    </a>
  )}

  {featured && featured.data.faqs.length > 0 && (
    <div class="col" style="padding-bottom:8px">
      <details class="home-faq">
        <summary>Common questions</summary>
        <div style="margin-top:14px"><Faq faqs={featured.data.faqs} /></div>
      </details>
    </div>
  )}

  {posts.length < 2 ? (
    <div class="col note">Only one article published so far — the index list grid appears once more are added.</div>
  ) : (
    <div class="col grid">
      {posts.filter((p) => p !== featured).map((p) => (
        <a class="card" href={`/blog/${p.id}/`}>
          <PillarTag pillar={p.data.pillar} />
          <h2>{p.data.title}</h2>
          <span class="meta">{p.data.readTime}</span>
        </a>
      ))}
    </div>
  )}

  <SignupBlock style="margin-top:24px" />
</Base>

<style>
  .intro { padding-top: 36px; padding-bottom: 32px; border-bottom: 1px solid var(--subtle); }
  .intro-label, .feature-label {
    font-family: var(--font-label); font-size: 12px; font-weight: 600; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--muted); margin-bottom: 12px;
  }
  .intro h1 { font-size: 28px; line-height: 1.2; margin: 0 0 14px; }
  .intro p { font-size: 16px; line-height: 1.6; color: var(--muted); margin: 0; max-width: 560px; }
  .feature-label { padding: 28px 20px 0; }
  .feature { display: block; color: inherit; max-width: 1120px; margin: 0 auto; padding: 0; }
  .feature:hover { text-decoration: none; color: inherit; }
  .feature-img { width: 100%; aspect-ratio: 16 / 9; max-height: 300px; overflow: hidden; }
  .feature-img img { width: 100%; height: 100%; object-fit: cover; }
  .feature-text { padding: 20px; max-width: 680px; }
  .feature-text :global(.pillar-tag) { margin-bottom: 14px; }
  .feature h2 { font-size: 28px; line-height: 1.15; margin: 0 0 12px; }
  .feature p { font-size: 18px; line-height: 1.6; color: var(--muted); margin: 0 0 14px; }
  .meta { font-size: 14px; color: var(--muted); }
  @media (min-width: 960px) {
    .intro { padding-top: 56px; padding-bottom: 48px; }
    .intro h1 { font-size: 40px; line-height: 1.15; }
    .intro p { font-size: 18px; }
    .feature { padding: 40px 20px 0; }
    .feature-label { padding: 0; }
    .feature-text { padding: 28px 0; }
    .feature h2 { font-size: 36px; }
  }
  .home-faq { border-top: 1px solid var(--subtle); padding-top: 16px; }
  .home-faq summary { font-family: var(--font-label); font-size: 13px; color: var(--muted); cursor: pointer; }
  .note { padding-top: 32px; padding-bottom: 8px; font-size: 12px; color: var(--muted); font-style: italic; }
  .grid { display: grid; gap: 20px; padding-top: 32px; }
  .card { color: inherit; border-top: 1px solid var(--subtle); padding-top: 16px; }
  .card h2 { font-size: 22px; line-height: 1.2; margin: 10px 0 6px; }
</style>

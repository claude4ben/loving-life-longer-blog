---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PillarTag from '../components/PillarTag.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import SignupBlock from '../components/SignupBlock.astro';
import { PILLAR_COLORS, type Pillar } from '../data/site';
import { readTime } from '../lib/article-meta';
import { block, inline } from '../lib/markdown';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = posts.find((p) => p.data.featured) ?? posts[0];

const home = (await getEntry('home', 'home'))!;
const intro = home.data;

// {think}, {move} and {live} in the headline show in their pillar colours.
const headline = inline(intro.headline).replace(/\{(think|move|live)\}/g, (_, w: string) =>
  `<span style="color:${PILLAR_COLORS[(w[0].toUpperCase() + w.slice(1)) as Pillar]}">${w}</span>`,
);
---
<Base>
  <div class="wide home">
    <section class="intro">
      <div class="label" set:html={inline(intro.label)} />
      <h1 set:html={headline} />
      <div class="intro-body" set:html={block(home.body)} />
    </section>

    {featured && (
      <a class="feature" href={`/blog/${featured.id}/`}>
        <div class="label">Latest article</div>
        <div class="feature-img breakout">
          <Photo src={featured.data.heroImage} alt={featured.data.heroAlt} focus={featured.data.heroFocus} zoom={featured.data.heroZoom} sizes="(min-width: 1320px) 1128px, 100vw" eager />
        </div>
        <div class="feature-text">
          <div class="feature-title">
            <PillarTag pillar={featured.data.pillar} />
            <h2>{featured.data.title}</h2>
          </div>
          <div class="feature-summary">
            <p>{featured.data.standfirst}</p>
            <div class="feature-meta">
              <span class="meta">{readTime(featured.body)}</span>
              <span class="read-more">Read the article →</span>
            </div>
          </div>
        </div>
      </a>
    )}

    {intro.faqs.length > 0 && (
      <details class="home-faq">
        <summary>Common questions</summary>
        <div class="faq-body"><Faq faqs={intro.faqs} /></div>
      </details>
    )}

    {posts.length < 2 ? (
      <div class="note">Only one article published so far — the index list grid appears once more are added.</div>
    ) : (
      <div class="grid">
        {posts.filter((p) => p !== featured).map((p) => (
          <a class="card" href={`/blog/${p.id}/`}>
            <PillarTag pillar={p.data.pillar} />
            <h2>{p.data.title}</h2>
            <span class="meta">{readTime(p.body)}</span>
          </a>
        ))}
      </div>
    )}
  </div>

  <SignupBlock style="margin-top:24px" />
</Base>

<style>
  /* Everything on the home page shares one width (the photo's), so all left edges line up. */
  .label {
    font-family: var(--font-label); font-size: 12px; font-weight: 600; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--muted); margin-bottom: 12px;
  }

  .intro { padding: 36px 0 32px; border-bottom: 1px solid var(--subtle); }
  .intro h1 { font-size: 30px; line-height: 1.2; margin: 0 0 16px; max-width: 960px; }
  .intro-body { font-size: 17px; line-height: 1.6; color: var(--muted); max-width: 760px; }
  .intro-body :global(p) { margin: 0 0 10px; }
  .intro-body :global(p:last-child) { margin-bottom: 0; }
  .intro-body :global(ul), .intro-body :global(ol) { margin: 0 0 10px; padding-left: 1.3em; }

  .feature { display: block; color: inherit; padding-top: 28px; }
  .feature:hover { text-decoration: none; color: inherit; }
  .feature:hover h2 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .feature-img { width: 100%; aspect-ratio: 16 / 9; max-height: 480px; overflow: hidden; }
  .feature-text { padding: 20px 0 8px; }
  .feature-title :global(.pillar-tag) { margin-bottom: 14px; }
  .feature h2 { font-size: 28px; line-height: 1.15; margin: 0 0 12px; }
  .feature-summary p { font-size: 18px; line-height: 1.6; color: var(--muted); margin: 0 0 14px; }
  .feature-meta { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .meta { font-size: 14px; color: var(--muted); }
  .read-more { font-size: 15px; font-weight: 600; color: var(--accent); }

  .home-faq { border-top: 1px solid var(--subtle); margin-top: 24px; padding-top: 16px; max-width: 760px; }
  .home-faq summary { font-family: var(--font-label); font-size: 13px; color: var(--muted); cursor: pointer; min-height: 32px; }
  .faq-body { margin-top: 14px; }
  .note { padding: 32px 0 8px; font-size: 12px; color: var(--muted); font-style: italic; }
  .grid { display: grid; gap: 20px; padding-top: 32px; }
  .card { color: inherit; border-top: 1px solid var(--subtle); padding-top: 16px; }
  .card h2 { font-size: 22px; line-height: 1.2; margin: 10px 0 6px; }

  @media (min-width: 960px) {
    .intro { padding: 64px 0 56px; }
    .intro h1 { font-size: 48px; line-height: 1.12; margin-bottom: 20px; }
    .intro-body { font-size: 20px; }
    .feature { padding-top: 48px; }
    /* Title on the left, summary on the right, spanning the photo's width. */
    .feature-text { display: grid; grid-template-columns: 1.15fr 1fr; gap: 56px; padding: 28px 0 8px; }
    .feature h2 { font-size: 38px; margin: 0; }
    .feature-summary { padding-top: 38px; }
    .feature-summary p { font-size: 19px; }
    .grid { grid-template-columns: repeat(2, 1fr); gap: 32px; }
  }
</style>

---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import SignupBlock from '../components/SignupBlock.astro';
import { PILLAR_COLORS, type Pillar } from '../data/site';
import { block, inline } from '../lib/markdown';

// Text comes from src/content/pages/about.md
const page = (await getEntry('about', 'about'))!;
const d = page.data;
---
<Base title="About">
  <div class="col about">
    <div class="photo breakout"><img src={d.photo} alt={d.photoAlt} /></div>
    <h1 set:html={inline(d.heading)} />
    <div class="bio" set:html={block(page.body)} />
    {d.placeholderNote && <div class="placeholder-note" style="margin-bottom:36px">{d.placeholderNote}</div>}

    <h2 set:html={inline(d.believeHeading)} />
    <div class="pillars">
      {(Object.keys(d.pillars) as Pillar[]).map((name) => (
        <div class="pillar-card">
          <div class="pillar-label" style={`color:${PILLAR_COLORS[name]}`}>{name}</div>
          <div class="pillar-text" set:html={inline(d.pillars[name])} />
        </div>
      ))}
    </div>

    <h2 set:html={inline(d.peopleHeading)} />
    <div class="people">
      {d.people.map((p) => (
        <div class="person">
          <img src={p.photo} alt={p.name} />
          <div><div class="name">{p.name}</div><div class="role" set:html={inline(p.role)} /></div>
        </div>
      ))}
    </div>

    <div class="note-card">
      <h2 set:html={inline(d.note.title)} />
      <p set:html={inline(d.note.body)} />
    </div>

    <div class="strip breakout">
      {d.strip.map((src) => <img src={src} alt="" />)}
    </div>

    <SignupBlock compact />
  </div>
</Base>

<style>
  .about { padding-top: 40px; padding-bottom: 40px; }
  .photo { width: 100%; aspect-ratio: 4 / 3; max-height: 300px; margin: 0 auto 28px; overflow: hidden; }
  .photo img, .strip img { width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 960px) { .photo { max-width: 420px; } }
  h1 { font-size: 32px; line-height: 1.2; margin: 0 0 16px; }
  .bio { font-size: 18px; line-height: 1.65; }
  .bio :global(p), .bio :global(ul), .bio :global(ol) { margin: 0 0 16px; }
  .bio :global(ul), .bio :global(ol) { padding-left: 1.4em; }
  .bio :global(li) { margin-bottom: 6px; }
  .bio :global(li::marker) { color: var(--accent); }
  .bio:not(:has(+ .placeholder-note)) { margin-bottom: 36px; }
  h2 { font-size: 22px; margin: 0 0 16px; }
  .pillars { display: grid; grid-template-columns: 1fr; gap: 20px; margin-bottom: 40px; }
  @media (min-width: 960px) { .pillars { grid-template-columns: repeat(3, 1fr); } }
  .pillar-card { background: var(--subtle); border-radius: 8px; padding: 20px; }
  .pillar-label { font-family: var(--font-label); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px; }
  .pillar-text { font-size: 15px; line-height: 1.5; }
  .people { display: flex; flex-direction: column; gap: 20px; margin-bottom: 40px; }
  .person { display: flex; gap: 14px; align-items: center; }
  .person img { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .name { font-weight: 600; font-size: 15px; }
  .role { font-size: 13px; color: var(--muted); }
  .note-card { background: var(--ink); color: var(--white); border-radius: 8px; padding: 32px 24px; margin-bottom: 36px; }
  .note-card h2 { font-size: 20px; margin: 0 0 14px; }
  .note-card p { font-size: 16px; line-height: 1.65; margin: 0; }
  .note-card :global(a) { color: var(--sage); }
  .strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; margin-bottom: 40px; }
  .strip img { aspect-ratio: 1; }
  @media (min-width: 960px) { .strip { gap: 12px; } }
</style>

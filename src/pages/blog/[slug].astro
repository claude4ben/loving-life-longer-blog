---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PillarTag from '../../components/PillarTag.astro';
import Faq from '../../components/Faq.astro';
import SignupBlock from '../../components/SignupBlock.astro';
import { splitSections } from '../../lib/sections';
import { photoFor } from '../../lib/images';
import { dateLabel, readTime } from '../../lib/article-meta';
import Photo from '../../components/Photo.astro';
import ArticleLinks from '../../components/ArticleLinks.astro';
import { wordCount } from '../../lib/sections';
import { blogPosting, breadcrumbs, faqPage, jsonLd, shareImage } from '../../lib/seo';
import { SHARE_OPTIONS } from '../../lib/share';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const d = post.data;

// Photos placed in the text are resolved next to the article file, e.g. ./my-article/photo.jpg.
const sections = await Promise.all(
  splitSections(post.body ?? '').map(async (s) => ({
    ...s,
    image: s.photo && { ...s.photo, src: await photoFor(s.photo.src, 'blog') },
  })),
);

// Search and AI labels: this is a blog post by Ben, with these questions and answers.
const site = Astro.site!;
const url = new URL(Astro.url.pathname, site).href;
const sharePicture = await shareImage(d.heroImage, site);
const structuredData = jsonLd([
  blogPosting({
    url, title: d.title, description: d.standfirst, image: sharePicture, date: d.date,
    author: d.author, pillar: d.pillar, wordCount: wordCount(post.body ?? ''), site,
  }),
  faqPage(d.faqs),
  breadcrumbs([{ name: 'Home', url: site.href }, { name: d.title, url }]),
]);
---
<Base
  title={d.title} description={d.standfirst} type="article" image={d.heroImage} imageAlt={d.heroAlt || d.title}
  published={d.date} author={d.author} section={d.pillar} structuredData={structuredData}
>
  <div class="progress" aria-hidden="true"><div data-progress></div></div>

  <header class="wide article-head">
    <PillarTag pillar={d.pillar} />
    <div class="headline">
      <h1>{d.title}</h1>
      <p class="standfirst">{d.standfirst}</p>
    </div>
    <div class="byline">
      <span class="avatar"><Photo src={d.avatar} alt={d.author} focus={d.avatarFocus} zoom={d.avatarZoom} sizes="56px" widths={[112, 168]} /></span>
      <div class="by-text">
        <div class="by-name">{d.author}</div>
        <div class="by-note">{d.disclosure}</div>
        <div class="by-meta"><span>{readTime(post.body)}</span><span aria-hidden="true">·</span><time datetime={d.date.toISOString().slice(0, 10)}>{dateLabel(d.date)}</time></div>
      </div>
    </div>
  </header>

  <div class="wide">
    <div class="hero reveal breakout">
      <Photo src={d.heroImage} alt={d.heroAlt} focus={d.heroFocus} zoom={d.heroZoom} sizes="(min-width: 960px) 1128px, 100vw" eager />
      {d.heroCaption && <div class="caption"><span>{d.heroCaption}</span></div>}
    </div>
  </div>

  <div class="wide toc-wrap">
    <button class="toc-btn" data-toc-toggle aria-expanded="false">
      <span>Table of contents</span><span data-toc-glyph>+</span>
    </button>
    <div class="toc" data-toc hidden>
      {sections.map((s) => <a href={`#${s.id}`} data-toc-link>{s.heading}</a>)}
    </div>
  </div>

  <article id="article-body">
    {sections.map((s) =>
      s.image ? (
        <section id={s.id} class:list={['sec-split', { 'img-left': s.image.side === 'left' }]}>
          {/* Photo comes first so text can wrap around it on desktop; on mobile it shows after the text. */}
          <div class="sec-img reveal breakout">
            <Photo src={s.image.src} alt={s.image.alt} focus={s.image.focus} zoom={s.image.zoom} sizes="(min-width: 960px) 50vw, 100vw" widths={[400, 800, 1200]} />
            {s.image.caption && <div class="caption"><span>{s.image.caption}</span></div>}
          </div>
          <div class="sec-text">
            <h2>{s.heading}</h2>
            <Fragment set:html={s.html} />
          </div>
        </section>
      ) : (
        <section id={s.id} class="wide sec-plain">
          <h2>{s.heading}</h2>
          <Fragment set:html={s.html} />
        </section>
      ),
    )}
  </article>

  <!-- Comments come straight after the article; links and common questions follow. -->
  <section id="comments-section" class="wide comments">
    <h2>Comments (<span data-comment-count>0</span>)</h2>
    <div class="comments-grid">
    <form class="comment-form" data-comment-form novalidate>
      <label class="sr-only" for="comment-name">Name</label>
      <input class="field" id="comment-name" name="name" placeholder="Name" autocomplete="name" autocapitalize="words" maxlength="80" />
      <label class="sr-only" for="comment-email">Email (optional, not published, used to let you know we have replied)</label>
      <input class="field" id="comment-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="Email (optional, not published)" aria-describedby="comment-email-hint" />
      <p class="field-hint" id="comment-email-hint">Only used to let you know we have replied.</p>
      <label class="sr-only" for="comment-text">Comment</label>
      <textarea class="field" id="comment-text" name="text" rows="3" placeholder="Add a comment" autocomplete="off"></textarea>
      <!-- Hidden from people; bots that fill it in are ignored. -->
      <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="form-foot">
        <a href="/policy/#comments-policy">Policy</a>
        <button class="btn" type="submit">Post comment</button>
      </div>
    </form>
    <div class="comments-side">
      <p class="comment-notice" data-comment-notice role="status" hidden></p>
      <div class="comment-list" data-comments></div>
    </div>
    </div>
  </section>

  <ArticleLinks links={d.links} title={d.linksTitle} />

  {d.faqs.length > 0 && (
    <div class="wide faq-wrap">
      <div class="faq-card">
        <div class="faq-label">Common questions</div>
        <Faq faqs={d.faqs} />
      </div>
    </div>
  )}

  <!-- Engagement: mobile bottom bar -->
  <div class="engage-bar mobile-only">
    <button data-like aria-pressed="false"><span class="sr-only">Like</span><svg class="heart" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg><span data-like-count>0</span></button>
    <button data-to-comments><span class="sr-only">Comments</span><svg class="icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg><span data-comment-count>0</span></button>
    <button data-share-open>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.6" y1="10.6" x2="15.4" y2="6.4"></line><line x1="8.6" y1="13.4" x2="15.4" y2="17.6"></line></svg>Share
    </button>
  </div>

  <!-- Engagement: desktop side rail -->
  <div class="engage-rail desktop-only">
    <button data-like aria-pressed="false"><span class="sr-only">Like</span><svg class="heart" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg><span data-like-count>0</span></button>
    <button data-to-comments><span class="sr-only">Comments</span><svg class="icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg><span data-comment-count>0</span></button>
    <button data-share-open>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.6" y1="10.6" x2="15.4" y2="6.4"></line><line x1="8.6" y1="13.4" x2="15.4" y2="17.6"></line></svg>Share
    </button>
  </div>

  <!-- Share sheet: copy link, then a grid of genuine brand icons (src/lib/share.ts). Phones also get "More",
       which opens the phone's own share menu. -->
  <div class="scrim" data-share hidden>
    <div class="sheet" role="dialog" aria-label="Share this article">
      <div class="sheet-title">Share this article</div>
      <button class="copy-row" data-copy>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 15l6-6"></path><path d="M11 5l1.5-1.5a3.54 3.54 0 015 5L16 10"></path><path d="M13 19l-1.5 1.5a3.54 3.54 0 01-5-5L8 14"></path></svg>
        <span data-copy-label>Copy link</span>
      </button>
      <div class="share-grid">
        {SHARE_OPTIONS.map((o) => {
          const tile = (
            <Fragment>
              <span class="tile" style={`background:${o.bg};color:${o.fg ?? '#ffffff'}`} aria-hidden="true">
                <svg viewBox={o.viewBox ?? '0 0 24 24'} width="24" height="24" class:list={{ outline: o.outline }}><path d={o.path} /></svg>
              </span>
              <span class="share-label">{o.label}</span>
            </Fragment>
          );
          return o.copy ? (
            <button class="share-opt" data-copy data-copy-for={o.label}>{tile}</button>
          ) : (
            <a class:list={['share-opt', { 'mobile-only': o.phonesOnly }]} data-share-link={o.id}
               target={o.id === 'email' || o.id === 'sms' ? undefined : '_blank'} rel="noopener">{tile}</a>
          );
        })}
        <button class="share-opt" data-native-share hidden>
          <span class="tile" style="background:#e8eaed;color:#1d1d1d" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24"><circle cx="5" cy="12" r="2"></circle><circle cx="12" cy="12" r="2"></circle><circle cx="19" cy="12" r="2"></circle></svg>
          </span>
          <span class="share-label">More</span>
        </button>
      </div>
    </div>
  </div>


  <SignupBlock />

  <script is:inline type="application/json" id="post-meta" set:html={JSON.stringify({ id: post.id, title: d.title, summary: d.standfirst, image: sharePicture })}></script>
</Base>

<script>
  import { initArticle } from '../../scripts/article';
  initArticle();
</script>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 6px; background: var(--subtle); z-index: 60; }
  .progress > div { height: 100%; width: 0; background: var(--accent); transition: width 0.1s linear; }

  .article-head { padding-top: 32px; }
  .article-head :global(.pillar-tag) { margin-bottom: 16px; }
  /* Phones: title about twice the text size, summary close to text size, so the title leads (Ben, 2026-10-29). */
  .article-head h1 { font-size: 32px; line-height: 1.15; margin: 0 0 12px; }
  .standfirst { font-size: 17px; line-height: 1.5; color: var(--muted); margin: 0 0 6px; }
  .byline { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
  .avatar { width: 56px; height: 56px; border-radius: 50%; overflow: hidden; flex-shrink: 0; }
  .by-name { font-size: 14px; font-weight: 600; }
  .by-note, .by-meta { font-size: 13px; color: var(--muted); }
  /* Date and read time sit under the name, lined up with it, instead of floating on the right. */
  .by-meta { display: flex; flex-wrap: wrap; gap: 0 6px; margin-top: 2px; }

  /* Top photo: 16:9 and edge to edge on phones; on desktop up to 480px tall and lined up with the text. */
  .hero { position: relative; width: 100%; aspect-ratio: 16 / 9; max-height: 480px; margin-bottom: 8px; overflow: hidden; }

  /* Scroll-reveal zoom */
  .reveal { --reveal: 1.08; }
  .reveal.is-visible { --reveal: 1; }
  .reveal > :global(img) { transition: transform 2.2s var(--ease-reveal); } /* slow, gentle zoom (Ben, 2026-10-29) */
  @media (prefers-reduced-motion: reduce) {
    .reveal { --reveal: 1 !important; }
    .reveal > :global(img) { transition: none; }
  }

  .toc-wrap { padding-top: 24px; }
  .toc-btn {
    width: 100%; display: flex; align-items: center; justify-content: space-between;
    background: var(--subtle); border: none; border-radius: 8px; padding: 14px 16px;
    font-family: var(--font-label); font-size: 14px; font-weight: 600; cursor: pointer; color: var(--ink);
  }
  .toc { border: 1px solid var(--subtle); border-top: none; border-radius: 0 0 8px 8px; padding: 8px 16px; display: flex; flex-direction: column; }
  .toc[hidden] { display: none; }
  .toc a { padding: 10px 0; border-bottom: 1px solid var(--subtle); font-size: 14px; color: var(--muted); }

  #article-body { padding: 24px 0 8px; }
  #article-body h2 { font-size: 24px; margin: 0 0 14px; }
  #article-body :global(p),
  #article-body :global(li) { font-size: 17px; line-height: 1.65; }
  #article-body :global(p) { margin: 0 0 16px; }
  #article-body :global(ul),
  #article-body :global(ol) { margin: 0 0 16px; padding-left: 1.4em; }
  #article-body :global(li) { margin: 0 0 8px; padding-left: 4px; }
  #article-body :global(li::marker) { color: var(--accent); }
  #article-body :global(strong) { font-weight: 700; }
  /* Space before the next heading: 20% less than before (Ben, 2026-10-28). */
  .sec-plain { padding-bottom: 29px; }
  .sec-split { padding: 0 20px 27px; display: flex; flex-direction: column; }
  .sec-split .sec-img { order: 2; } /* mobile: text first, then the photo */
  .sec-img { aspect-ratio: 4 / 3; max-height: 300px; position: relative; overflow: hidden; margin-bottom: 24px; }
  /* Caption over the bottom left of a photo: white text on a dark fade, with a soft shadow, so it's readable on any photo. */
  .caption { position: absolute; left: 0; right: 0; bottom: 0; padding: 40px 20px 18px; text-align: left; background: linear-gradient(transparent, rgba(0, 0, 0, 0.6)); }
  .caption span { display: block; max-width: 80%; color: var(--white); font-family: var(--font-display); font-size: 20px; font-weight: 600; line-height: 1.3; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5); }

  @media (min-width: 960px) {
    /* The title uses the full width (one line when it fits); the summary below matches the title's width. */
    .article-head h1 { font-size: 44px; }
    .headline { width: fit-content; max-width: 100%; }
    .standfirst { font-size: 21px; line-height: 1.6; width: 0; min-width: 100%; }
    /* Table of contents: headings in three columns when open. */
    .toc { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 32px; }
    /* Q&A in two columns. */
    .faq-card { padding: 32px; }
    .faq-card :global(.qa) { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 48px; }
    /* Comments: form on the left (stays in view), comments on the right. */
    .comments-grid { display: grid; grid-template-columns: minmax(300px, 2fr) 3fr; gap: 56px; align-items: start; }
    .comment-form { position: sticky; top: 100px; margin-bottom: 0; }
    .comment-notice { margin: 0 0 16px; }
    #article-body :global(p),
    #article-body :global(li) { font-size: 19px; }
    /* Text wraps around the photo, then runs full width once it passes the bottom of the photo. */
    .sec-split { display: flow-root; max-width: 1320px; margin: 0 auto 48px; padding: 0 96px; }
    .sec-img {
      float: right; width: calc(50% - 28px); margin: 6px 0 24px 56px;
      aspect-ratio: auto; max-height: none; height: 460px;
    }
    .img-left .sec-img { float: left; margin: 6px 56px 24px 0; }
    /* Each paragraph and bullet point keeps one width: a paragraph that starts beside the photo stays in
       that column to its end; the next one below the photo runs full width. Bullets stay visible. */
    .sec-split :global(p) { display: flow-root; }
    .sec-split :global(li) { display: list-item flow-root; }
  }

  .faq-wrap { padding-top: 8px; padding-bottom: 40px; }
  .faq-card { background: var(--subtle); border-radius: 8px; padding: 24px; }
  .faq-label { font-family: var(--font-label); font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); margin-bottom: 14px; }

  .engage-bar {
    position: fixed; bottom: 0; left: 0; right: 0; background: var(--white); border-top: 1px solid var(--subtle);
    display: flex; align-items: center; justify-content: space-around; padding: 8px 12px; z-index: 60;
  }
  .engage-bar button, .engage-rail button {
    display: flex; align-items: center; gap: 6px; background: none; border: none;
    min-width: 44px; min-height: 44px; font-size: 15px; cursor: pointer; color: var(--ink);
  }
  .engage-rail {
    position: fixed; right: 24px; top: 50%; transform: translateY(-50%); background: var(--white);
    border: 1px solid var(--subtle); border-radius: 10px; flex-direction: column; padding: 8px; gap: 4px;
    z-index: 60; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }
  .engage-rail button { flex-direction: column; gap: 2px; font-size: 12px; }
  .engage-rail button[data-like] { font-size: 13px; }
  /* Like: the standard outline heart, filled red when liked (as on Instagram, Substack, X). */
  .heart, .icon { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.15s ease; }
  :global([data-like].liked) .heart { fill: var(--like); stroke: var(--like); }
  :global([data-like]:active) .heart { transform: scale(0.88); }

  .scrim { position: fixed; inset: 0; background: var(--scrim); z-index: 70; display: flex; align-items: flex-end; justify-content: center; }
  .scrim[hidden] { display: none; }
  .sheet { background: var(--white); border-radius: 12px 12px 0 0; padding: 20px 20px 24px; width: 100%; max-width: 440px; display: flex; flex-direction: column; max-height: 90vh; overflow-y: auto; }
  .sheet-title { font-family: var(--font-label); font-weight: 600; font-size: 14px; margin-bottom: 10px; }
  .copy-row {
    display: flex; align-items: center; gap: 10px; width: 100%; padding: 12px 14px; margin-bottom: 14px; cursor: pointer;
    border: 1px solid var(--border-input); border-radius: 8px; background: var(--white); color: var(--ink);
    font-family: inherit; font-size: 15px; font-weight: 500; text-align: left;
  }
  .copy-row:hover { background: var(--subtle); }
  /* A grid of round brand icons, four across. */
  .share-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px 6px; }
  .share-opt {
    display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 4px 0; min-height: 44px; cursor: pointer;
    border: none; background: none; color: var(--ink); font-family: inherit; text-decoration: none;
  }
  .share-opt[hidden] { display: none; }
  .share-opt:hover { text-decoration: none; color: var(--ink); }
  .share-opt:hover .tile { transform: scale(1.06); }
  .tile { width: 52px; height: 52px; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: transform 0.15s ease; }
  .tile svg { fill: currentColor; }
  .tile svg.outline { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .share-label { font-size: 12px; line-height: 1.2; text-align: center; }

  .comments { padding-top: 32px; padding-bottom: 48px; }
  .comments h2 { font-size: 22px; margin: 0 0 20px; }
  .field-hint { font-size: 13px; color: var(--muted); margin: -4px 0 4px; }
  .comment-form { display: flex; flex-direction: column; gap: 10px; margin-bottom: 32px; }
  .form-foot { display: flex; align-items: center; justify-content: space-between; }
  .form-foot a { font-size: 12px; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; opacity: 0; }
  .comment-notice { font-size: 14px; color: var(--accent); margin: -16px 0 24px; }
  .comments-side { min-width: 0; }
  .comment-list :global(.c-empty) { font-size: 15px; color: var(--muted); margin: 0; padding: 20px; background: var(--subtle); border-radius: 8px; }
  .comment-notice.error { color: #b3261e; }
  .comment-list :global(.c-badge) {
    font-family: var(--font-label); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--white); background: var(--accent); border-radius: 4px; padding: 1px 6px;
  }
  .comment-list { display: flex; flex-direction: column; gap: 24px; }
  .comment-list :global(.c) { display: flex; gap: 12px; }
  .comment-list :global(.c.reply) { margin-top: 16px; margin-left: 48px; }
  .comment-list :global(.c-av) {
    width: 36px; height: 36px; border-radius: 50%; background: var(--subtle); display: flex; align-items: center;
    justify-content: center; font-size: 13px; font-weight: 600; color: var(--muted); flex-shrink: 0;
  }
  .comment-list :global(.reply .c-av) { width: 32px; height: 32px; font-size: 12px; }
  .comment-list :global(.c-body) { flex: 1; }
  .comment-list :global(.c-head) { display: flex; align-items: baseline; gap: 8px; }
  .comment-list :global(.c-name) { font-weight: 600; font-size: 14px; }
  .comment-list :global(.c-time) { font-size: 12px; color: var(--muted); }
  .comment-list :global(.c-text) { font-size: 15px; line-height: 1.5; margin: 6px 0 0; }
</style>

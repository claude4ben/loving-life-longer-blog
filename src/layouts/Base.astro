---
// Fonts are served from this site (no Google Fonts): faster, and no visitor data goes to Google.
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/rubik/500.css';
import '@fontsource/rubik/600.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { HIDE_FROM_SEARCH, SITE_NAME } from '../data/site';
import { LOCALE, SITE_DESCRIPTION, shareImage } from '../lib/seo';

interface Props {
  title?: string; description?: string; noindex?: boolean;
  // Share previews and search labels (see src/lib/seo.ts).
  image?: ImageMetadata | string; imageAlt?: string; type?: 'website' | 'article';
  published?: Date; author?: string; section?: string; structuredData?: string;
}
const {
  title, noindex = false, description = SITE_DESCRIPTION, image, imageAlt = SITE_NAME, type = 'website',
  published, author, section, structuredData,
} = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const ogImage = await shareImage(image, site);

// "Blog" links to the newest article until there is an article index.
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const blogHref = posts[0] ? `/blog/${posts[0].id}/` : '/';
const path = Astro.url.pathname;
const nav = [
  { label: 'Home', href: '/', active: path === '/' },
  { label: 'Blog', href: blogHref, active: path.startsWith('/blog') },
  { label: 'About', href: '/about/', active: path.startsWith('/about') },
];
import SocialLinks from '../components/SocialLinks.astro';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(HIDE_FROM_SEARCH || noindex) && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && (
      <Fragment>
        <link rel="canonical" href={canonical} />
        <link rel="sitemap" href="/sitemap.xml" />
        <!-- Share previews (Facebook, WhatsApp, LinkedIn, X, iMessage, Slack) -->
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:locale" content={LOCALE} />
        <meta property="og:type" content={type} />
        <meta property="og:title" content={title ?? SITE_NAME} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:alt" content={imageAlt} />
        {type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
        {type === 'article' && author && <meta property="article:author" content={author} />}
        {type === 'article' && section && <meta property="article:section" content={section} />}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        {structuredData && <script is:inline type="application/ld+json" set:html={structuredData} />}
      </Fragment>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- The wordmark font is tiny (only its letters), so it's fetched straight away to avoid a flash. -->
    <link rel="preload" href="/fonts/fraunces-wordmark.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <div class="wide header-in">
        <a class="brand" href="/">
          <span class="brand-logo"><img src="/logo.svg" alt="Loving Life Longer logo" /></span>
          <span class="brand-name">{SITE_NAME}</span>
        </a>
        <nav class="nav desktop-only">
          {nav.map((n) => <a href={n.href} aria-current={n.active ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <button class="burger mobile-only" aria-label="Menu" data-menu-open>
          <span></span><span></span><span></span>
        </button>
        </div>
      </header>

      <div class="mobile-nav" hidden data-menu>
        <button class="close" aria-label="Close" data-menu-close>×</button>
        <nav>
          {nav.map((n) => <a href={n.href} aria-current={n.active ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>

      <main><slot /></main>

      <footer class="site-footer">
        <SocialLinks />
        <small>© 2026 {SITE_NAME}</small>
        <a href="/policy/">Policy</a>
      </footer>
    </div>

    <script>
      const menu = document.querySelector<HTMLElement>('[data-menu]')!;
      document.querySelector('[data-menu-open]')?.addEventListener('click', () => (menu.hidden = false));
      document.querySelector('[data-menu-close]')?.addEventListener('click', () => (menu.hidden = true));
    </script>
  </body>
</html>
